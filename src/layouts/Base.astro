---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import fontLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Page à tenir hors de l'index (404) : noindex, sans URL canonique. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// Indexation : le build de production (`npm run build`, Cloudflare Pages) est indexable ; le serveur de
// développement ne l'est jamais. PUBLIC_INDEXABLE=false au build donne une version non indexable (préproduction).
const indexable = import.meta.env.PROD && import.meta.env.PUBLIC_INDEXABLE !== 'false' && !noindex;

// URLs absolues tirées de `site` (astro.config.mjs) : canonique, Open Graph, image de partage.
const site = Astro.site;
const canonical = site && !noindex ? new URL(Astro.url.pathname, site).href : null;
const shareImage = site ? new URL('/media/stage-rs3-desktop.webp', site).href : null;
const shareImageAlt =
  'Berline sportive garée de nuit sur une route en corniche, face à une baie éclairée sous la lune.';
// Données structurées limitées au site lui-même (nom et adresse vérifiés) : aucune donnée d'entreprise.
const website =
  site && !noindex && Astro.url.pathname === '/'
    ? { '@context': 'https://schema.org', '@type': 'WebSite', name: 'MECA RIVIERA', url: site.href, inLanguage: 'fr-FR' }
    : null;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="google-site-verification" content="yTOK6gV9eUTSqvL4AHSAidnKTmVU95w9ha3bNE4q_MQ" />
    <meta name="theme-color" content="#0b0c0e" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="MECA RIVIERA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {
      shareImage && (
        <>
          <meta property="og:image" content={shareImage} />
          <meta property="og:image:type" content="image/webp" />
          <meta property="og:image:width" content="1440" />
          <meta property="og:image:height" content="900" />
          <meta property="og:image:alt" content={shareImageAlt} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {
      shareImage && (
        <>
          <meta name="twitter:image" content={shareImage} />
          <meta name="twitter:image:alt" content={shareImageAlt} />
        </>
      )
    }
    {website && <script is:inline type="application/ld+json" set:html={JSON.stringify(website)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <slot />
  </body>
</html>
