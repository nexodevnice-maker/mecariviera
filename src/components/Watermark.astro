---
/**
 * Filigrane de prévisualisation « nexoDeveloppement ».
 * Calque fixe plein écran, au-dessus de tout le site (3D comprise), sans bloquer clics ni scroll,
 * ignoré par les lecteurs d'écran. Pour le retirer : supprimer <Watermark /> dans layouts/Base.astro.
 */
const label = 'nexoDeveloppement';
---

<svg class="watermark" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <pattern
      id="nexo-watermark"
      width="540"
      height="140"
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(-30)"
    >
      <text x="0" y="40">{label}</text>
      <text x="270" y="110">{label}</text>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#nexo-watermark)"></rect>
</svg>

<style>
  .watermark {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    pointer-events: none;
    user-select: none;
  }

  .watermark text {
    font-family: var(--font);
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.04em;
    fill: rgb(242 241 238 / 0.1);
    stroke: rgb(11 12 14 / 0.08);
    stroke-width: 0.6px;
  }

  @media print {
    .watermark text {
      fill: rgb(0 0 0 / 0.12);
    }
  }
</style>
