---
import { buildCoast, curve } from '../content/coast';
import { contact, zone } from '../content/site';

const [phone, second] = contact.phones.value;
const towns = zone.towns.value;

// Carte schématique (pas un fond cartographique) : projection équirectangulaire locale,
// à la même échelle dans les deux directions (1 km ≈ 44,4 unités).
const LON0 = 7.05;
const LAT0 = 43.73;
const KX = 3571.7; // 4936 × cos(43,63°)
const KY = 4936; // unités par degré de latitude
const KM = KY / 111.2;
type Pt = [number, number];
const project = ([lon, lat]: Pt): Pt => [(lon - LON0) * KX, (LAT0 - lat) * KY];
const f = (n: number) => n.toFixed(1);

/** Courbe lissée (Catmull-Rom → Bézier) passant par tous les points. */
const smooth = (pts: Pt[]) => {
  let d = `M${f(pts[0][0])},${f(pts[0][1])}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const [p0, p1, p2, p3] = [pts[i - 1] ?? pts[i], pts[i], pts[i + 1], pts[i + 2] ?? pts[i + 1]];
    d += ` C${f(p1[0] + (p2[0] - p0[0]) / 6)},${f(p1[1] + (p2[1] - p0[1]) / 6)}`;
    d += ` ${f(p2[0] - (p3[0] - p1[0]) / 6)},${f(p2[1] - (p3[1] - p1[1]) / 6)} ${f(p2[0])},${f(p2[1])}`;
  }
  return d;
};

/** Décalage vers le large : la mer est à droite du sens de tracé du rivage. */
const offset = (pts: Pt[], d: number): Pt[] =>
  pts.map((p, i) => {
    const a = pts[Math.max(0, i - 1)];
    const b = pts[Math.min(pts.length - 1, i + 1)];
    const length = Math.hypot(b[0] - a[0], b[1] - a[1]) || 1;
    return [p[0] - ((b[1] - a[1]) / length) * d, p[1] + ((b[0] - a[0]) / length) * d];
  });

/** Degrés et minutes : 43.7031 → « 43°42′ ». */
const dm = (value: number) => {
  const minutes = Math.round(value * 60);
  return `${Math.floor(minutes / 60)}°${String(minutes % 60).padStart(2, '0')}′`;
};

// Trait de côte simplifié, de Golfe-Juan au cap Ferrat (lon, lat approximatifs).
const shore = (
  [
    [7.05, 43.567], [7.078, 43.566], [7.108, 43.566], [7.12, 43.556], [7.13, 43.545], [7.14, 43.56],
    [7.132, 43.575], [7.128, 43.585], [7.126, 43.592], [7.133, 43.616], [7.141, 43.64], [7.165, 43.658],
    [7.195, 43.66], [7.213, 43.652], [7.225, 43.66], [7.245, 43.685], [7.268, 43.694], [7.286, 43.696],
    [7.297, 43.686], [7.31, 43.7], [7.33, 43.68],
  ] as Pt[]
).map(project);
const coast = smooth(shore);
const land = `${coast} L1000,0 L0,0 Z`;
/** Points intermédiaires de la courbe du rivage : des décalages réguliers. */
const densify = (pts: Pt[], steps = 4): Pt[] => {
  const out: Pt[] = [];
  for (let i = 0; i < pts.length - 1; i++) {
    const [p0, p1, p2, p3] = [pts[i - 1] ?? pts[i], pts[i], pts[i + 1], pts[i + 2] ?? pts[i + 1]];
    for (let s = 0; s < steps; s++) {
      const t = s / steps;
      const at = (k: 0 | 1) =>
        0.5 *
        (2 * p1[k] +
          (p2[k] - p0[k]) * t +
          (2 * p0[k] - 5 * p1[k] + 4 * p2[k] - p3[k]) * t * t +
          (3 * p1[k] - p0[k] - 3 * p2[k] + p3[k]) * t * t * t);
      out.push([at(0), at(1)]);
    }
  }
  out.push(pts[pts.length - 1]);
  return out;
};

/** Moyenne glissante : adoucit les décalages dans les creux du rivage. */
const relax = (pts: Pt[], radius: number): Pt[] =>
  pts.map((_, i) => {
    const window = pts.slice(Math.max(0, i - radius), i + radius + 1);
    return [0, 1].map((k) => window.reduce((sum, p) => sum + p[k], 0) / window.length) as Pt;
  });

// Lignes de sonde : le rivage répété vers le large, de plus en plus espacé (repère marin, sans cote).
const soundings = [26, 60, 104].map((d) => smooth(relax(offset(densify(shore), d), 3)));

// Cadre et graticule toutes les 3′ (0,05°).
const VIEW = { x: 110, y: 80, w: 830, h: 860 };
const meridians = [7.1, 7.15, 7.2, 7.25, 7.3].map((lon) => ({ x: project([lon, LAT0])[0], label: `${dm(lon)}E` }));
const parallels = [43.55, 43.6, 43.65, 43.7].map((lat) => ({ y: project([LON0, lat])[1], label: `${dm(lat)}N` }));
const scale = { x: VIEW.x + VIEW.w - 60 - 5 * KM, y: VIEW.y + VIEW.h - 46 };

// Tournée : elle relie les communes du nord-est au sud-ouest, la zone couverte en halo autour. Le point
// de la tournée y entre par la route du littoral, depuis le bord est de la carte (le halo, lui, s'en tient
// aux communes).
const byName = new Map(towns.map((t) => [t.name, project([t.lon, t.lat])]));
const tour = [
  byName.get('Nice'),
  project([7.22, 43.672]),
  project([7.19, 43.668]),
  byName.get('Cagnes-sur-Mer'),
  byName.get('Villeneuve-Loubet'),
  project([7.118, 43.63]),
  project([7.12, 43.603]),
  byName.get('Antibes'),
].filter((p): p is Pt => Boolean(p));
const EDGE = project([7.31, 43.705]);
const reach = smooth(tour);
const route = smooth([EDGE, ...tour]);
const townsText = towns.map((t) => t.name).join(', ');

// Étiquettes : nom et coordonnées. Nice à gauche (bord de carte), Villeneuve-Loubet dessous (trop proche de Cagnes).
const LEFT = new Set(['Nice']);
const BELOW = new Set(['Villeneuve-Loubet']);
const pins = towns.map((t) => {
  const [x, y] = project([t.lon, t.lat]);
  const left = LEFT.has(t.name);
  const below = BELOW.has(t.name);
  return {
    name: t.name,
    coords: `${dm(t.lat)}N · ${dm(t.lon)}E`,
    x,
    y,
    lx: below ? x - 8 : left ? x - 24 : x + 24,
    side: below ? 'below' : left ? 'left' : 'right',
    anchor: left ? 'end' : 'start',
    dy: below ? '2.1em' : '-0.3em',
  };
});

// — Téléphone : la carte étendue, de Cannes à Beaulieu-sur-Mer (tracé et lignes de sonde : src/content/coast.ts) ;
// l'ordinateur garde la sienne.
const sea = buildCoast();
const at = sea.project;
const PV = sea.view;
const PKM = sea.km;
// Communes : Nice à gauche, Villeneuve-Loubet dessous (trop proche de Cagnes), les autres à droite.
const phonePins = towns.map((t) => {
  const [x, y] = at([t.lon, t.lat]);
  const left = t.name === 'Nice';
  const below = t.name === 'Villeneuve-Loubet';
  return {
    name: t.name,
    coords: `${dm(t.lat)}N · ${dm(t.lon)}E`,
    x,
    y,
    lx: below ? x - 8 : left ? x - 26 : x + 26,
    side: below ? 'below' : left ? 'left' : 'right',
    anchor: left ? 'end' : 'start',
    dy: below ? '2.1em' : '-0.3em',
  };
});
const phoneAt = new Map(phonePins.map((p) => [p.name, [p.x, p.y] as Pt]));
const phoneTour = [
  phoneAt.get('Nice'),
  at([7.22, 43.672]),
  at([7.19, 43.668]),
  phoneAt.get('Cagnes-sur-Mer'),
  phoneAt.get('Villeneuve-Loubet'),
  at([7.118, 43.63]),
  at([7.12, 43.603]),
  phoneAt.get('Antibes'),
].filter((p): p is Pt => Boolean(p));
// Le point de la tournée entre par la basse corniche, depuis Èze-sur-Mer : Beaulieu, Villefranche, le port de Nice.
const phoneEntry = (
  [
    [7.372, 43.7245], [7.352, 43.7168], [7.333, 43.7088], [7.322, 43.7048], [7.311, 43.7058], [7.298, 43.6962], [7.286, 43.6982],
  ] as Pt[]
).map(at);
const phoneReach = curve(phoneTour);
const phoneRoute = curve([...phoneEntry, ...phoneTour]);
// La nuit sur la côte : la lueur chaude des villes, discrète (centre, rayon en km).
const glows = (
  [
    [7.255, 43.71, 4], [7.005, 43.56, 3], [7.11, 43.58, 2.6], [7.07, 43.575, 1.4], [7.15, 43.67, 1.8], [7.185, 43.68, 1.5],
    [7.125, 43.656, 1], [7.325, 43.705, 1.1],
  ] as [number, number, number][]
).map(([lon, lat, r]) => ({ c: at([lon, lat]), r: r * PKM }));
// Repères : les deux bouts de la côte, et ce qui la dessine (caps, îles, fleuve), les eaux.
const places = [
  { name: 'Cannes', at: at([7.0174, 43.5513]), anchor: 'middle', dx: 0, dy: -20 },
  { name: 'Beaulieu-sur-Mer', at: at([7.3322, 43.7076]), anchor: 'end', dx: 14, dy: -28 },
];
const features = [
  { text: 'Cap d’Antibes', at: at([7.13, 43.5413]), anchor: 'start', dx: 14, dy: 30 },
  { text: 'Cap Ferrat', at: at([7.329, 43.6718]), anchor: 'middle', dx: 0, dy: 40 },
  { text: 'Îles de Lérins', at: at([7.0655, 43.517]), anchor: 'start', dx: 16, dy: 14 },
  { text: 'Var', at: at([7.1925, 43.738]), anchor: 'start', dx: 10, dy: 0 },
];
const phoneSea = at([7.25, 43.556]);
const phoneBay = at([7.22, 43.606]);
const phoneMeridians = [7.0, 7.1, 7.2, 7.3].map((lon) => at([lon, 43.7])[0]);
const phoneParallels = [43.55, 43.6, 43.65, 43.7, 43.75].map((lat) => at([7.2, lat])[1]);
const phoneScale = { x: PV.w - 44 - 5 * PKM, y: PV.h - 34 };
---

<section class="zone" id="zone" aria-labelledby="zone-title">
  <!-- Téléphone : la ligne de relevé en tête de la zone, qui monte sur la Méthode (relais). -->
  <span class="zone__line" aria-hidden="true"></span>
  <div class="wrap zone__grid">
    <div class="zone__head">
      <p class="label zone__kicker">Zone d’intervention</p>
      <h2 class="zone__title" id="zone-title">Où est garé votre véhicule&nbsp;?</h2>
    </div>

    <figure class="zone__map zone__map--desk" data-map data-door="30">
      <svg viewBox={`${VIEW.x} ${VIEW.y} ${VIEW.w} ${VIEW.h}`} role="img" aria-labelledby="zone-map-title">
        <title id="zone-map-title">
          Carte schématique du littoral entre Antibes et Nice, avec {towns.map((t) => t.name).join(', ')}.
        </title>
        <defs>
          <radialGradient id="zone-fade-gradient" cx="50%" cy="48%" r="62%">
            <stop offset="58%" stop-color="#fff"></stop>
            <stop offset="100%" stop-color="#000"></stop>
          </radialGradient>
          <mask id="zone-fade" maskUnits="userSpaceOnUse" x={VIEW.x} y={VIEW.y} width={VIEW.w} height={VIEW.h}>
            <rect x={VIEW.x} y={VIEW.y} width={VIEW.w} height={VIEW.h} fill="url(#zone-fade-gradient)"></rect>
          </mask>
          <filter id="zone-soft" x="-25%" y="-25%" width="150%" height="150%">
            <feGaussianBlur stdDeviation="30"></feGaussianBlur>
          </filter>
        </defs>

        <g mask="url(#zone-fade)">
          <path class="zone__land" d={land}></path>
          <g class="zone__graticule">
            {meridians.map((m) => <path d={`M${f(m.x)},${VIEW.y} V${VIEW.y + VIEW.h}`} />)}
            {parallels.map((p) => <path d={`M${VIEW.x},${f(p.y)} H${VIEW.x + VIEW.w}`} />)}
          </g>
          {soundings.map((d, i) => <path class="zone__sounding" d={d} style={`--depth: ${i}`} />)}
          <path class="zone__reach" d={reach} filter="url(#zone-soft)"></path>
          <path class="zone__coast" d={coast}></path>
        </g>

        <g class="zone__degrees" aria-hidden="true">
          {meridians.map((m) => <text x={f(m.x + 6)} y={VIEW.y + 24}>{m.label}</text>)}
          {parallels.map((p) => <text x={VIEW.x + 8} y={f(p.y - 8)}>{p.label}</text>)}
        </g>
        <text class="zone__water zone__water--sea" x="600" y="772">Méditerranée</text>
        <text class="zone__water zone__water--bay" x="640" y="446">Baie des Anges</text>

        <path class="zone__route" d={route} pathLength="1" data-route></path>

        {
          pins.map((p) => (
            <g class="zone__pin" data-pin={p.name} data-x={f(p.x)} data-y={f(p.y)}>
              <circle cx={f(p.x)} cy={f(p.y)} r="48" class="zone__hit" />
              <g class="zone__mark">
                <circle cx={f(p.x)} cy={f(p.y)} r="15" class="zone__halo" />
                <circle cx={f(p.x)} cy={f(p.y)} r="5.5" class="zone__dot" />
              </g>
              <text x={f(p.lx)} y={f(p.y)} text-anchor={p.anchor} data-side={p.side}>
                <tspan class="zone__name" dy={p.dy}>
                  {p.name}
                </tspan>
                <tspan class="zone__coords" x={f(p.lx)} dy="1.5em">
                  {p.coords}
                </tspan>
                <!-- Commune choisie : « Votre véhicule » à la place des coordonnées (même place, sans collision). -->
                <tspan class="zone__yours" x={f(p.lx)} dy="0">Votre véhicule</tspan>
              </text>
            </g>
          ))
        }

        <!-- Votre véhicule : posé sur la commune choisie ; la tournée vient jusqu'au bord du cercle. -->
        <g class="zone__here" data-here aria-hidden="true">
          <circle class="zone__here-ring" r="30"></circle>
          <circle class="zone__here-dot" r="10"></circle>
        </g>
        <!-- Le point de la tournée : au-dessus de tout, jusqu'au véhicule. -->
        <circle class="zone__van" r="9" cx={f(EDGE[0])} cy={f(EDGE[1])} data-van></circle>

        <g class="zone__north" transform="translate(250 205)" aria-hidden="true">
          <path d="M0,32 V-6"></path>
          <path class="zone__north-head" d="M-6,4 L0,-10 L6,4 Z"></path>
          <text y="-22" text-anchor="middle">N</text>
        </g>
        <g class="zone__scale" transform={`translate(${f(scale.x)} ${f(scale.y)})`} aria-hidden="true">
          <path d={`M0,0 H${f(5 * KM)}`}></path>
          {[0, 1, 2, 3, 4, 5].map((k) => <path d={`M${f(k * KM)},0 V${k % 5 ? -6 : -12}`} />)}
          <text x="0" y="-22">0</text>
          <text x={f(5 * KM)} y="-22" text-anchor="end">5 km</text>
        </g>
      </svg>
      <figcaption class="label">Carte schématique — {zone.area.value}</figcaption>
    </figure>

    <!-- Téléphone : la carte étendue — le littoral de Cannes à Beaulieu-sur-Mer, ses lignes de sonde, la lueur des
         villes, et, dans son cartouche, le drapeau du département. Mêmes communes, même tournée. -->
    <figure class="zone__map zone__map--phone" data-map data-door="34">
      <div class="zone__layers">
      <!-- Le fond (côte, sondes, lueurs, repères, cartouche) : dessiné une fois. -->
      <svg class="zone__base" viewBox={`${PV.x} ${PV.y} ${PV.w} ${PV.h}`} aria-hidden="true">
        <defs>
          <radialGradient id="zone-fade-gradient-phone" cx="50%" cy="50%" r="66%">
            <stop offset="62%" stop-color="#fff"></stop>
            <stop offset="100%" stop-color="#000"></stop>
          </radialGradient>
          <mask id="zone-fade-phone" maskUnits="userSpaceOnUse" x={PV.x} y={PV.y} width={PV.w} height={PV.h}>
            <rect x={PV.x} y={PV.y} width={PV.w} height={PV.h} fill="url(#zone-fade-gradient-phone)"></rect>
          </mask>
          <filter id="zone-soft-phone" x="-25%" y="-25%" width="150%" height="150%">
            <feGaussianBlur stdDeviation="20"></feGaussianBlur>
          </filter>
          <radialGradient id="zone-glow-phone">
            <stop offset="0%" stop-color="#ffd7a3" stop-opacity="0.16"></stop>
            <stop offset="45%" stop-color="#ffc98a" stop-opacity="0.06"></stop>
            <stop offset="100%" stop-color="#ffc98a" stop-opacity="0"></stop>
          </radialGradient>
        </defs>

        <g mask="url(#zone-fade-phone)">
          <path class="zone__land" d={sea.land}></path>
          {sea.islands.map((d) => <path class="zone__land" d={d} />)}
          {glows.map((g) => <circle cx={f(g.c[0])} cy={f(g.c[1])} r={f(g.r)} fill="url(#zone-glow-phone)" />)}
          <g class="zone__graticule">
            {phoneMeridians.map((x) => <path d={`M${f(x)},${PV.y} V${PV.y + PV.h}`} />)}
            {phoneParallels.map((y) => <path d={`M${PV.x},${f(y)} H${PV.x + PV.w}`} />)}
          </g>
          {sea.soundings.map((lines, i) => lines.map((d) => <path class="zone__sounding" d={d} style={`--depth: ${i}`} />))}
          <path class="zone__river" d={sea.river}></path>
          <path class="zone__reach" d={phoneReach} filter="url(#zone-soft-phone)"></path>
          <path class="zone__coast" d={sea.coast}></path>
          {sea.islands.map((d) => <path class="zone__coast" d={d} />)}
        </g>

        <text class="zone__water zone__water--sea" x={f(phoneSea[0])} y={f(phoneSea[1])} text-anchor="middle">Méditerranée</text>
        <text class="zone__water zone__water--bay" x={f(phoneBay[0])} y={f(phoneBay[1])} text-anchor="middle">Baie des Anges</text>
        {
          features.map((m) => (
            <text class="zone__feature" x={f(m.at[0] + m.dx)} y={f(m.at[1] + m.dy)} text-anchor={m.anchor}>
              {m.text}
            </text>
          ))
        }
        {
          places.map((p) => (
            <g class="zone__place">
              <circle cx={f(p.at[0])} cy={f(p.at[1])} r="5" />
              <text x={f(p.at[0] + p.dx)} y={f(p.at[1] + p.dy)} text-anchor={p.anchor}>
                {p.name}
              </text>
            </g>
          ))
        }

        <!-- Cartouche : le drapeau du département, son nom, son numéro. -->
        <g class="zone__cartouche" aria-hidden="true">
          <!-- Le drapeau traditionnel des Alpes-Maritimes (Wikimedia Commons, domaine public). -->
          <image href="/media/flag-06.svg" x="26" y="26" width="132" height="83.7" preserveAspectRatio="xMidYMid meet"></image>
          <text class="zone__cartouche-name" x="176" y="60">Alpes-Maritimes</text>
          <text class="zone__cartouche-num" x="174" y="110">06</text>
        </g>

        <g class="zone__north" transform="translate(945 72)" aria-hidden="true">
          <path d="M0,32 V-6"></path>
          <path class="zone__north-head" d="M-6,4 L0,-10 L6,4 Z"></path>
          <text y="-22" text-anchor="middle">N</text>
        </g>
        <g class="zone__scale" transform={`translate(${f(phoneScale.x)} ${f(phoneScale.y)})`} aria-hidden="true">
          <path d={`M0,0 H${f(5 * PKM)}`}></path>
          {[0, 1, 2, 3, 4, 5].map((k) => <path d={`M${f(k * PKM)},0 V${k % 5 ? -6 : -12}`} />)}
          <text x="0" y="-22">0</text>
          <text x={f(5 * PKM)} y="-22" text-anchor="end">5 km</text>
        </g>
      </svg>
      <!-- Au-dessus, sur son propre calque : ce qui bouge (tournée, point, repère) et ce qu'on touche (communes) — la
           tournée animée ne fait jamais redessiner le fond (masque, flou). -->
      <svg class="zone__over" viewBox={`${PV.x} ${PV.y} ${PV.w} ${PV.h}`} role="img" aria-labelledby="zone-map-title-phone">
        <title id="zone-map-title-phone">
          Carte schématique du littoral de Cannes à Beaulieu-sur-Mer, avec {townsText}, et le drapeau des Alpes-Maritimes.
        </title>
        <path class="zone__route" d={phoneRoute} pathLength="1" data-route></path>

        {
          phonePins.map((p) => (
            <g class="zone__pin" data-pin={p.name} data-x={f(p.x)} data-y={f(p.y)}>
              <circle cx={f(p.x)} cy={f(p.y)} r="56" class="zone__hit" />
              <g class="zone__mark">
                <circle cx={f(p.x)} cy={f(p.y)} r="15" class="zone__halo" />
                <circle cx={f(p.x)} cy={f(p.y)} r="5.5" class="zone__dot" />
              </g>
              <text x={f(p.lx)} y={f(p.y)} text-anchor={p.anchor} data-side={p.side}>
                <tspan class="zone__name" dy={p.dy}>
                  {p.name}
                </tspan>
                <tspan class="zone__coords" x={f(p.lx)} dy="1.5em">
                  {p.coords}
                </tspan>
                <tspan class="zone__yours" x={f(p.lx)} dy="0">
                  Votre véhicule
                </tspan>
              </text>
            </g>
          ))
        }

        <g class="zone__here" data-here aria-hidden="true">
          <circle class="zone__here-ring" r="34"></circle>
          <circle class="zone__here-dot" r="11"></circle>
        </g>
        <circle class="zone__van" r="11" cx={f(phoneEntry[0][0])} cy={f(phoneEntry[0][1])} data-van></circle>
      </svg>
      </div>
      <figcaption class="label">Carte schématique, de Cannes à Beaulieu-sur-Mer — {zone.area.value}</figcaption>
    </figure>

    <div class="zone__body">
      <!-- Les choix n'existent qu'avec le script (la carte répond) ; sans lui, la liste des communes ci-dessous. -->
      <div class="zone__towns" role="group" aria-labelledby="zone-title" data-towns hidden>
        {
          pins.map((p) => (
            <button type="button" class="zone__town" data-town={p.name} aria-pressed="false">
              {p.name}
            </button>
          ))
        }
      </div>
      <p class="zone__answer" data-answer aria-live="polite">
        {townsText} {zone.surroundings.value}, dans les {zone.area.value}.
      </p>
      <p class="zone__note">
        Vous êtes ailleurs dans le 06&nbsp;? Appelez&nbsp;: on vous dit si l’intervention est possible chez vous.
      </p>
      <a class="btn btn--primary zone__cta" href={phone.href}>
        Appeler<span class="btn__sep" aria-hidden="true"></span>{phone.display}
      </a>
      {
        second && (
          <a class="btn btn--ghost zone__cta zone__cta--second" href={second.href}>
            Appeler<span class="btn__sep" aria-hidden="true" />
            {second.display}
          </a>
        )
      }
    </div>
  </div>
</section>

<script>
  import { zone } from '../content/site';

  // La carte répond à « où est garé votre véhicule ? » : le véhicule est posé sur la commune choisie ;
  // le point de la tournée entre par la route du littoral et s'arrête auprès de lui ; la demande (plus
  // bas) est préparée pour cette commune (événement meca:town). Sans choix, à l'entrée de la carte, la
  // tournée parcourt la zone. Un trajet choisi hors écran (sur mobile, les choix sont sous la carte) se
  // joue quand la carte apparaît. Sans script : tracé fixe et liste des communes ; mouvement réduit :
  // mêmes états d'arrivée, sans trajet.
  const answer = document.querySelector<HTMLElement>('[data-answer]');
  const choices = document.querySelector<HTMLElement>('[data-towns]');
  const buttons = choices ? [...choices.querySelectorAll<HTMLButtonElement>('[data-town]')] : [];
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ease = (t: number) => (t < 0.5 ? 4 * t ** 3 : 1 - (2 - 2 * t) ** 3 / 2);

  /**
   * Une carte (ordinateur ou téléphone : une seule affichée) — son tracé, le point de la tournée, le repère « Votre
   * véhicule », ses communes. Rend la fonction qui y pose le véhicule ; hors écran, ou carte masquée, le trajet attend
   * qu'elle apparaisse.
   */
  const setup = (figure: HTMLElement) => {
    const route = figure.querySelector<SVGPathElement>('[data-route]');
    const van = figure.querySelector<SVGCircleElement>('[data-van]');
    const here = figure.querySelector<SVGGElement>('[data-here]');
    if (!route || !van) return null;
    /** Rayon du repère « Votre véhicule » : le point de la tournée s'arrête à son bord. */
    const door = Number(figure.dataset.door ?? 30);
    // Le tracé, mesuré et échantillonné une fois (240 pas) à la première apparition de la carte : pendant le trajet,
    // aucune mesure du SVG (chacune forcerait le style et la mise en page de la page entière).
    const STEPS = 240;
    let total = 0;
    let samples: Float32Array | null = null;
    const table = () => {
      if (samples) return samples;
      total = route.getTotalLength();
      samples = new Float32Array((STEPS + 1) * 2);
      for (let k = 0; k <= STEPS; k++) {
        const point = route.getPointAtLength((total * k) / STEPS);
        samples[k * 2] = point.x;
        samples[k * 2 + 1] = point.y;
      }
      return samples;
    };
    const length = () => (table(), total);
    /** Longueur du tracé au plus près d'un point de la carte. */
    const nearest = (x: number, y: number) => {
      const s = table();
      let best = 0;
      let gap = Infinity;
      for (let k = 0; k <= STEPS; k++) {
        const d = (s[k * 2] - x) ** 2 + (s[k * 2 + 1] - y) ** 2;
        if (d < gap) {
          gap = d;
          best = (total * k) / STEPS;
        }
      }
      return best;
    };
    /** Le point de la tournée à une longueur du tracé, et le trait dessiné jusque-là. */
    const place = (along: number) => {
      const s = table();
      const at = Math.min(Math.max((along / total) * STEPS, 0), STEPS);
      const k = Math.min(Math.floor(at), STEPS - 1);
      const t = at - k;
      route.style.strokeDashoffset = String(1 - along / total);
      van.setAttribute('cx', (s[k * 2] + (s[k * 2 + 2] - s[k * 2]) * t).toFixed(1));
      van.setAttribute('cy', (s[k * 2 + 1] + (s[k * 2 + 3] - s[k * 2 + 1]) * t).toFixed(1));
    };
    let run = 0;
    /** Parcourt le tracé jusqu'à `to` ; `stay` : le point reste à l'arrivée, auprès du véhicule. */
    const drive = (to: number, stay: boolean) => {
      const token = ++run;
      route.classList.add('is-drawn');
      van.classList.add('is-on');
      if (still) {
        place(to);
        van.classList.toggle('is-on', stay);
        return;
      }
      const duration = 900 + 1500 * (to / length());
      const start = performance.now();
      const step = (now: number) => {
        if (token !== run) return;
        const t = Math.min((now - start) / duration, 1);
        place(ease(t) * to);
        if (t < 1) requestAnimationFrame(step);
        else if (!stay) van.classList.remove('is-on');
      };
      requestAnimationFrame(step);
    };

    let visible = false;
    let toured = false;
    let chosen: [number, number] | null = null;
    let pending = false;
    const toward = ([x, y]: [number, number]) => Math.max(nearest(x, y) - door, 0);
    if (!still) route.classList.add('is-armed');
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (!visible) return;
        if (pending && chosen) drive(toward(chosen), true);
        else if (!toured && !chosen) drive(length(), false);
        pending = false;
        toured = true;
      },
      { threshold: 0.35 },
    ).observe(figure);

    // Sur la carte aussi, toucher une commune la choisit (les boutons restent le chemin du clavier et des
    // lecteurs d'écran).
    const pins = [...figure.querySelectorAll<SVGGElement>('[data-pin]')];
    for (const pin of pins) pin.addEventListener('click', () => buttons.find((b) => b.dataset.town === pin.dataset.pin)?.click());
    figure.classList.add('is-live');
    return (town: string) => {
      const pin = pins.find((p) => p.dataset.pin === town);
      if (!pin) return;
      for (const p of pins) p.classList.toggle('is-here', p === pin);
      chosen = [Number(pin.dataset.x), Number(pin.dataset.y)];
      here?.setAttribute('transform', `translate(${chosen[0]} ${chosen[1]})`);
      here?.classList.add('is-set');
      if (visible) drive(toward(chosen), true);
      else pending = true;
    };
  };
  const maps = [...document.querySelectorAll<HTMLElement>('[data-map]')].flatMap((figure) => setup(figure) ?? []);

  if (maps.length) {
    // Les communes deviennent des choix : sous eux, seulement ce que la liste ne dit pas.
    choices?.removeAttribute('hidden');
    const around = zone.surroundings.value;
    if (answer) answer.textContent = `${around.charAt(0).toUpperCase()}${around.slice(1)}, dans les ${zone.area.value}.`;
    for (const button of buttons) {
      button.addEventListener('click', () => {
        const town = button.dataset.town ?? '';
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
        for (const choose of maps) choose(town);
        if (answer) {
          const name = document.createElement('strong');
          name.textContent = town;
          const link = document.createElement('a');
          link.href = '#demande';
          link.textContent = 'Demander une intervention';
          answer.replaceChildren('On vient à ', name, '. ', link);
        }
        dispatchEvent(new CustomEvent('meca:town', { detail: town }));
      });
    }
  }

  // Téléphone : relais depuis la Méthode — la zone monte par-dessus sa dernière vue, encore épinglée ; la scène
  // s'éteint dessous. Progression (0 → 1) : le haut de la zone allant du bas au haut de l'écran.
  const zoneSection = document.getElementById('zone');
  const method = document.querySelector<HTMLElement>('[data-inspection]');
  const line = zoneSection?.querySelector<HTMLElement>('.zone__line');
  const grid = zoneSection?.querySelector<HTMLElement>('.zone__grid');
  const veil = method?.querySelector<HTMLElement>('.method__viewport');
  const phone = matchMedia('(max-width: 899px)');
  if (zoneSection && method && line && grid && veil) {
    let frame = 0;
    // Haut de la zone dans la page, relevé à la mise en page seulement ; les valeurs ne sont réécrites que si elles
    // changent, et seulement sur les trois pièces qui bougent — la ligne, le contenu de la zone, le voile de la Méthode —,
    // jamais en variable héritée par toute une section : le défilement ne coûte ni mesure ni recalcul de style.
    let top = 0;
    let stale = true;
    let last = '';
    const update = () => {
      frame = 0;
      zoneSection.classList.toggle('is-handoff', phone.matches);
      if (!phone.matches) {
        veil.style.removeProperty('--handoff');
        line.style.removeProperty('opacity');
        grid.style.removeProperty('opacity');
        stale = true;
        last = '';
        return;
      }
      if (stale) {
        top = zoneSection.getBoundingClientRect().top + window.scrollY;
        stale = false;
      }
      const enter = Math.min(Math.max(1 - (top - window.scrollY) / window.innerHeight, 0), 1);
      const key = enter.toFixed(3);
      if (key === last) return;
      last = key;
      line.style.opacity = (1 - 0.85 * enter).toFixed(3);
      grid.style.opacity = Math.min(Math.max(enter * 1.8 - 0.35, 0), 1).toFixed(3);
      veil.style.setProperty('--handoff', key);
    };
    const schedule = () => {
      frame ||= requestAnimationFrame(update);
    };
    const remeasure = () => {
      stale = true;
      schedule();
    };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', remeasure);
    phone.addEventListener('change', remeasure);
    new ResizeObserver(remeasure).observe(document.body);
    update();
  }
</script>

<style>
  .zone {
    padding-block: clamp(6rem, 12vw, 10rem);
    /* Nuit sur la baie : une lueur froide et basse, du côté de la mer. */
    background: radial-gradient(52% 58% at 78% 60%, rgb(36 85 255 / 0.07), transparent 72%);
  }

  /* Desktop : la question et les choix à gauche, centrés face à la carte. Mobile : question, carte, choix
     — la carte reste à l'écran quand on choisit. */
  /* Ligne de relevé du relais : téléphone, avec le script, seulement. */
  .zone__line {
    display: none;
  }

  .zone__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    grid-template-rows: 1fr auto auto 1fr;
    grid-template-areas: '. map' 'head map' 'body map' '. map';
    column-gap: clamp(2.5rem, 6vw, 6rem);
  }

  .zone__head {
    grid-area: head;
  }

  .zone__map {
    grid-area: map;
    align-self: center;
  }

  .zone__body {
    grid-area: body;
  }

  .zone__kicker {
    color: var(--blue-soft);
  }

  .zone__title {
    margin-top: 1.25rem;
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    line-height: 0.98;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* Communes : des choix — chasse normale et sans césure, pour ne jamais couper « Cagnes-sur-Mer ». */
  .zone__towns {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.125rem;
    margin-top: 1.75rem;
  }

  .zone__towns[hidden] {
    display: none;
  }

  .zone__town {
    position: relative;
    min-height: 2.75rem;
    padding: 0.25rem 0 0.25rem 1.75rem;
    border: 0;
    background: none;
    color: var(--text-2);
    font-weight: 800;
    font-size: clamp(1.25rem, 2.1vw, 1.875rem);
    line-height: 1.05;
    letter-spacing: -0.005em;
    text-align: left;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.2s;
  }

  .zone__town::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.75rem;
    height: 0.75rem;
    margin-top: -0.375rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .zone__town:hover,
  .zone__town[aria-pressed='true'] {
    color: var(--text);
  }

  .zone__town[aria-pressed='true']::before {
    background: var(--blue-soft);
    border-color: var(--blue-soft);
  }

  .zone__answer {
    margin-top: 1.25rem;
    font-size: 1.125rem;
    color: var(--text-2);
  }

  .zone__answer :global(strong) {
    color: var(--text);
  }

  .zone__answer :global(a) {
    margin-left: 0.25rem;
    color: var(--blue-soft);
    border-bottom: 1px solid currentColor;
  }

  .zone__note {
    max-width: 26rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--text-2);
  }

  .zone__cta {
    margin-top: 1.75rem;
  }

  /* Téléphone : les deux numéros, deux boutons d'appel pleine largeur (le second n'existe pas sur ordinateur). */
  .zone__cta--second {
    display: none;
  }

  @media (max-width: 899px) {
    .zone__cta {
      display: flex;
      width: 100%;
    }

    .zone__cta--second {
      margin-top: 0.625rem;
    }
  }

  .zone__map > svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* — Fond de carte ——————————————————————————— */

  .zone__land {
    fill: var(--ink-2);
  }

  .zone__graticule path {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .zone__sounding {
    fill: none;
    stroke: var(--blue-soft);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    opacity: calc(0.34 - var(--depth) * 0.07);
  }

  .zone__coast {
    fill: none;
    stroke: var(--text-2);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  /* Zone couverte : la tournée et ses alentours, en halo. */
  .zone__reach {
    fill: none;
    stroke: var(--blue);
    stroke-width: 120;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.12;
  }

  .zone__degrees text {
    fill: var(--text-3);
    font-size: 13px;
    letter-spacing: 0.06em;
  }

  .zone__water {
    fill: var(--blue-soft);
    font-style: italic;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .zone__water--sea {
    font-size: 19px;
  }

  .zone__water--bay {
    font-size: 14px;
  }

  /* — Tournée ——————————————————————————————— */

  .zone__route {
    fill: none;
    stroke: var(--blue-soft);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: opacity 0.2s;
  }

  /* Tracé animé (script) : masqué jusqu'à l'entrée de la carte, puis dessiné. */
  .zone__route:global(.is-armed) {
    stroke-dashoffset: 1;
    opacity: 0;
  }

  .zone__route:global(.is-armed.is-drawn) {
    opacity: 1;
  }

  .zone__van {
    fill: var(--paper);
    opacity: 0;
    transition: opacity 0.4s;
  }

  .zone__van:global(.is-on) {
    opacity: 1;
  }

  /* — Communes ——————————————————————————————— */

  .zone__mark {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Cible tactile d'une commune sur la carte (invisible) : active avec le script seulement. */
  .zone__hit {
    fill: transparent;
    pointer-events: none;
  }

  .zone__map:global(.is-live) .zone__hit {
    pointer-events: all;
  }

  .zone__map:global(.is-live) .zone__pin {
    cursor: pointer;
  }

  /* Tracé, point de la tournée et repère « Votre véhicule » passent au-dessus des communes : le doigt les
     traverse jusqu'à la commune. */
  .zone__route,
  .zone__van,
  .zone__here {
    pointer-events: none;
  }

  .zone__town:active {
    color: var(--text);
  }

  .zone__halo {
    fill: var(--ink);
    stroke: var(--blue-soft);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .zone__dot {
    fill: var(--paper);
  }

  .zone__pin text {
    paint-order: stroke;
    stroke: var(--ink);
    stroke-width: 6px;
    stroke-linejoin: round;
  }

  /* Commune choisie : l'étiquette s'écarte du cercle « Votre véhicule » et du point arrivé à son bord. */
  .zone__pin:global(.is-here) [data-side='right'] {
    transform: translateX(20px);
  }

  .zone__pin:global(.is-here) [data-side='left'] {
    transform: translateX(-20px);
  }

  .zone__pin:global(.is-here) [data-side='below'] {
    transform: translateY(14px);
  }

  .zone__name {
    fill: var(--text);
    font-stretch: var(--semi);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .zone__coords {
    fill: var(--text-3);
    font-size: 15px;
    letter-spacing: 0.04em;
  }

  /* — Votre véhicule ————————————————————————— */

  .zone__here {
    opacity: 0;
    transition: opacity 0.4s;
  }

  .zone__here:global(.is-set) {
    opacity: 1;
  }

  .zone__here-ring {
    fill: none;
    stroke: var(--blue-soft);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  .zone__here-dot {
    fill: var(--blue-soft);
  }

  .zone__yours {
    visibility: hidden;
    fill: var(--blue-soft);
    font-stretch: var(--semi);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .zone__pin:global(.is-here) .zone__coords {
    visibility: hidden;
  }

  .zone__pin:global(.is-here) .zone__yours {
    visibility: visible;
  }

  /* — Repères ——————————————————————————————— */

  .zone__north path,
  .zone__scale path {
    fill: none;
    stroke: var(--text-3);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .zone__north .zone__north-head {
    fill: var(--text-3);
  }

  .zone__north text,
  .zone__scale text {
    fill: var(--text-3);
    font-stretch: var(--semi);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.12em;
  }

  .zone__map figcaption {
    margin-top: 1rem;
    color: var(--text-3);
  }

  /* Téléphone, avec le script : la zone d'intervention vient par-dessus la fin de la Méthode (vue encore
     épinglée). Son bord est la ligne de relevé de l'inspection — un trait bleu qui monte et balaie la dernière
     vue, la carte relevée derrière lui, la scène s'éteignant dessous (Method.astro). Aucune transformation :
     textes et carte restent nets. */
  @media (max-width: 899px) {
    .zone:global(.is-handoff) {
      position: relative;
      z-index: 3;
      margin-top: -90vh;
      margin-top: -90svh;
      background:
        radial-gradient(52% 58% at 78% 60%, rgb(36 85 255 / 0.07), transparent 72%),
        var(--ink);
    }

    /* La ligne : fine, sa lueur bleue portée vers la scène qu'elle balaie ; elle s'éteint à l'arrivée. Son opacité,
       comme celle du contenu qui se révèle derrière elle, est posée par le script, sur ces deux pièces seulement. */
    .zone:global(.is-handoff) .zone__line {
      position: absolute;
      inset: 0 0 auto;
      display: block;
      height: 1px;
      background: var(--blue-soft);
      box-shadow:
        0 0 12px 1px rgb(134 166 255 / 0.7),
        0 -18px 48px 6px rgb(36 85 255 / 0.28);
      pointer-events: none;
    }
  }

  @media (max-width: 899px) {
    .zone__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-template-areas: 'head' 'map' 'body';
      row-gap: 2rem;
    }

    .zone__towns {
      margin-top: 0;
    }
  }

  /* Mobile : la carte se lit en 350 px — textes et repères agrandis, graticule allégé. */
  @media (max-width: 599px) {
    .zone {
      padding-block: 4.5rem 3.5rem;
    }

    .zone__title {
      font-size: 7.4vw;
    }

    .zone__town {
      font-size: 6.2vw;
    }

    .zone__name {
      font-size: 38px;
    }

    .zone__coords,
    .zone__yours {
      font-size: 26px;
    }

    .zone__degrees {
      display: none;
    }

    .zone__water--sea {
      font-size: 30px;
    }

    .zone__water--bay {
      font-size: 22px;
    }

    .zone__north text,
    .zone__scale text {
      font-size: 24px;
    }

    .zone__route {
      stroke-width: 6;
    }

    .zone__mark {
      transform: scale(1.5);
    }
  }

  /* — Téléphone : la carte étendue ———————————————— */

  /* Deux cartes : l'ordinateur garde la sienne (d'Antibes à Nice) ; le téléphone a celle de Cannes à Beaulieu-sur-Mer,
     avec le drapeau du département. Une seule est affichée. */
  .zone__map--phone {
    display: none;
  }

  @media (max-width: 899px) {
    .zone__map--desk {
      display: none;
    }

    .zone__map--phone {
      display: block;
    }
  }

  /* Deux calques superposés : le fond, dessiné une fois ; au-dessus, sur son propre calque de composition, la tournée
     animée, le point, le repère et les communes. */
  .zone__layers {
    display: grid;
  }

  .zone__layers > svg {
    grid-area: 1 / 1;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .zone__base {
    pointer-events: none;
  }

  .zone__over {
    will-change: transform;
  }

  .zone__river {
    fill: none;
    stroke: var(--blue-soft);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
    opacity: 0.45;
  }

  .zone__map--phone .zone__reach {
    stroke-width: 81;
  }

  .zone__map--phone .zone__route {
    stroke-width: 6.5;
  }

  .zone__map--phone .zone__name {
    font-size: 40px;
  }

  .zone__map--phone .zone__coords,
  .zone__map--phone .zone__yours {
    font-size: 27px;
  }

  .zone__map--phone .zone__water--sea {
    font-size: 30px;
  }

  .zone__map--phone .zone__water--bay {
    font-size: 25px;
  }

  .zone__map--phone .zone__north text,
  .zone__map--phone .zone__scale text {
    font-size: 22px;
