---
import { contact } from '../content/site';
import Mark from './Mark.astro';

const phone = contact.phones.value[0];
const snap = contact.snapchat.value;
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="MECA RIVIERA — accueil">
      <Mark class="brand__mark" />
      <span class="brand__name"><span class="meca">MECA</span> RIVIERA</span>
    </a>
    <nav class="site-nav" aria-label="Navigation principale">
      <ul>
        <li><a href="#services">Services</a></li>
        <li><a href="#methode">Méthode</a></li>
        <li><a href="#zone">Zone</a></li>
        <li><a href="#demande">Contact</a></li>
      </ul>
    </nav>
    {
      snap && (
        <a
          class="header-snap"
          href={`https://www.snapchat.com/add/${snap}`}
          rel="noopener"
          target="_blank"
          aria-label={`Snapchat de MECA RIVIERA (@${snap})`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.6c2.9 0 5 2.1 5 5.2v2.1c.4.2.9.2 1.3 0 .5-.2 1 .1 1 .6 0 .4-.3.7-.8.9-.6.2-1.3.5-1.4 1-.1.4.2.9.6 1.4 1 1.2 2.3 1.9 3.3 2.1.3.1.4.4.2.7-.4.6-1.5.9-2.4 1-.2 0-.3.2-.4.4l-.2.9c-.1.3-.4.4-.8.3-.7-.2-1.6-.3-2.5 0-.9.3-1.6 1.2-3.2 1.2s-2.3-.9-3.2-1.2c-.9-.3-1.8-.2-2.5 0-.4.1-.7 0-.8-.3l-.2-.9c-.1-.2-.2-.4-.4-.4-.9-.1-2-.4-2.4-1-.2-.3-.1-.6.2-.7 1-.2 2.3-.9 3.3-2.1.4-.5.7-1 .6-1.4-.1-.5-.8-.8-1.4-1-.5-.2-.8-.5-.8-.9 0-.5.5-.8 1-.6.4.2.9.2 1.3 0V7.8c0-3.1 2.1-5.2 5-5.2z" />
          </svg>
        </a>
      )
    }
    <div class="site-header__actions">
      <span class="header-hours">7j/7 · 24h/24</span>
      <a class="header-phone" href={phone.href}>
        <span class="label">Appeler</span>
        <span class="header-phone__num">{phone.display}</span>
      </a>
      <a class="btn btn--primary btn--small header-cta" href="#demande">Demander une intervention</a>
    </div>
  </div>
</header>

<script>
  // Amélioration progressive : en-tête opaque par défaut (sans JS), transparent seulement en haut de page.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.classList.toggle('is-top', window.scrollY <= 24);
    update();
    addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    background: rgb(11 12 14 / 0.94);
    border-bottom: 1px solid var(--line);
    transition:
      background-color 0.35s var(--ease-out),
      border-color 0.35s var(--ease-out);
  }

  /* Mobile : opaque dès qu'on quitte le haut de page — aucun texte ne transparaît sous l'en-tête. */
  @media (max-width: 899px) {
    .site-header {
      background: var(--ink);
    }
  }

  .site-header.is-top {
    background: transparent;
    border-bottom-color: transparent;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    height: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* Cibles tactiles de 44 px au moins (marge verticale : l'en-tête en a la place). */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    flex: none;
    padding-block: 0.6875rem;
  }

  .brand :global(.brand__mark) {
    width: 1.375rem;
    height: 1.375rem;
  }

  .brand__name {
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: 0.9375rem;
    letter-spacing: 0.03em;
  }

  .site-nav ul {
    display: flex;
    gap: 2rem;
  }

  .site-nav a {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.2s;
  }

  .site-nav a:hover {
    color: var(--text);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-left: auto;
  }

  .header-phone {
    display: inline-flex;
    align-items: baseline;
    gap: 0.625rem;
    padding-block: 0.75rem;
  }

  .header-phone .label {
    color: var(--text-3);
  }

  .header-phone__num {
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
  }

  @media (max-width: 1099px) {
    .site-nav {
      display: none;
    }
  }

  @media (max-width: 719px) {
    .header-cta,
    .header-phone .label {
      display: none;
    }

    .brand__name {
      font-size: 0.8125rem;
    }
  }

  /* Téléphone : entre la marque et la disponibilité, le Snapchat de MECA RIVIERA (centré dans l'espace libre) ;
     la disponibilité remplace le numéro, qui reste dans le hero et la barre d'appel. Absents sur ordinateur. */
  .header-snap,
  .header-hours {
    display: none;
  }

  @media (max-width: 899px) {
    .site-header__inner {
      gap: 1rem;
    }

    .header-snap {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: none;
      width: 2.75rem;
      height: 2.75rem;
      margin-inline: auto;
      color: var(--text);
      transition: color 0.2s;
    }

    .header-snap svg {
      width: 1.375rem;
      height: 1.375rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.6;
      stroke-linejoin: round;
    }

    .header-snap:active {
      color: var(--blue-soft);
    }

    .site-header__actions {
      margin-left: 0;
    }

    .header-phone {
      display: none;
    }

    .header-hours {
      display: inline;
      font-weight: 600;
      font-size: 0.875rem;
      letter-spacing: 0.01em;
      white-space: nowrap;
    }
  }
</style>
