---
/**
 * Entrée : « MECA RIVIERA — PRESENT » sur la nuit, le temps que la première scène soit réellement prête
 * (première image de la 3D rendue ; sans WebGL, l'affiche décodée). À chaque arrivée — rechargement, réouverture,
 * retour par l'historique, lien vers une section — on atterrit sur le premier plan et l'immersion recommence.
 * Ordinateur : ni pourcentage, ni barre ; elle se lève dès que la scène est prête — jamais avant une seconde de
 * lecture —, au plus tard après 5 s (l'affiche, identique à la première image de la 3D, prend alors le relais et la
 * 3D la remplace à son arrivée), et aussitôt à la moindre interaction. Téléphone : 2,5 s pleines, une fine barre
 * blanche qui se remplit, la page immobile pendant ce temps. L'arrivée des phares attend qu'elle se lève (événement
 * meca:enter). Sans script : aucune entrée.
 */
---

<script is:inline>
  (() => {
    // Toujours le premier plan à l'arrivée : aucune position de défilement restaurée, aucune ancre.
    const root = document.documentElement;
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    if (location.hash) history.replaceState(null, '', location.pathname + location.search);
    // Le haut est tenu à chaque image pendant l'entrée, puis 1,5 s après elle et après le chargement complet : Safari
    // et les navigateurs intégrés aux applications rétablissent parfois la position tard. Le premier geste du
    // visiteur, une fois l'entrée levée, lui rend la main (au plus tard 12 s après l'arrivée) ; en partant, la page se
    // remet en haut : aucun navigateur n'a d'autre position à restaurer.
    let free = false;
    let entered = false;
    let until = 12000;
    const hold = (now) => {
      if (free || now > until) return;
      if (scrollX || scrollY) scrollTo(0, 0);
      requestAnimationFrame(hold);
    };
    scrollTo(0, 0);
    requestAnimationFrame(hold);
    const arm = () => {
      if (entered && document.readyState === 'complete') until = performance.now() + 1500;
    };
    addEventListener(
      'meca:enter',
      () => {
        entered = true;
        scrollTo(0, 0);
        arm();
      },
      { once: true },
    );
    addEventListener('load', arm, { once: true });
    const release = () => {
      if (entered && !root.classList.contains('intro-lock')) free = true;
    };
    for (const type of ['wheel', 'touchstart', 'keydown', 'pointerdown']) addEventListener(type, release, { capture: true, passive: true });
    // Contrôle QA (captures) : la main tout de suite.
    addEventListener('meca:intro-finish', () => (free = true), { once: true });
    addEventListener('pagehide', () => scrollTo(0, 0));
    // Page restaurée telle quelle (retour par l'historique) : rechargée, l'entrée avec.
    addEventListener('pageshow', (event) => event.persisted && location.reload());
    root.classList.add('has-intro');
    // Téléphone : la page immobile pendant l'entrée.
    if (matchMedia('(max-width: 899px)').matches) root.classList.add('intro-lock');
  })();
</script>
<div class="intro" data-intro aria-hidden="true" data-nosnippet>
  <p class="intro__card">
    <span class="intro__brand"><span class="meca">MECA</span> RIVIERA</span>
    <span class="intro__present">PRESENT</span>
    <!-- Téléphone : une fine barre blanche se remplit pendant les 2,5 s de l'entrée. -->
    <span class="intro__bar"><span></span></span>
  </p>
</div>
<script is:inline>
  (() => {
    const root = document.documentElement;
    const intro = document.querySelector('[data-intro]');
    if (!intro) return;
    if (!root.classList.contains('has-intro')) return intro.remove();
    // Téléphone : l'entrée dure ses 2,5 s (la barre), sans être écourtée par un geste.
    const phone = matchMedia('(max-width: 899px)').matches;
    const MIN = phone ? 2500 : 1300; // lecture du titre, même quand tout est déjà en cache
    const MAX = phone ? 2500 : 5000; // au-delà, l'affiche prend le relais : la page n'attend pas une ressource lente
    const start = performance.now();
    let leaving = false;
    const leave = (instant) => {
      if (leaving) return;
      leaving = true;
      clearTimeout(timer);
      root.classList.remove('intro-lock');
      dispatchEvent(new CustomEvent('meca:enter'));
      const done = () => {
        intro.remove();
        root.classList.remove('has-intro');
      };
      if (instant) return done();
      intro.classList.add('is-leaving');
      intro.addEventListener('transitionend', (event) => event.target === intro && done());
      setTimeout(done, 1600);
    };
    const timer = setTimeout(() => leave(false), MAX);
    // Scène prête (événement de la 3D, ou repli statique : l'affiche doit alors être décodée).
    addEventListener(
      'meca:scene-ready',
      (event) => {
        const poster = event.detail?.static ? document.querySelector('.stage__poster img') : null;
        const decoded = poster?.decode
          ? Promise.race([poster.decode().catch(() => {}), new Promise((resolve) => setTimeout(resolve, 1500))])
          : Promise.resolve();
        decoded.then(() => setTimeout(() => leave(false), Math.max(0, MIN - (performance.now() - start))));
      },
      { once: true },
    );
    // Contrôle QA (captures) : levée immédiate, sans transition.
    addEventListener('meca:intro-finish', () => leave(true), { once: true });
    if (!phone) for (const type of ['wheel', 'touchstart', 'keydown', 'scroll']) addEventListener(type, () => leave(false), { passive: true, once: true });
    // Le titre n'apparaît qu'avec sa police (préchargée) : jamais de changement de fonte à l'écran.
    Promise.race([document.fonts ? document.fonts.ready : null, new Promise((resolve) => setTimeout(resolve, 800))]).then(() =>
      intro.classList.add('is-set'),
    );
  })();
</script>

<style>
  /* Au-dessus de l'en-tête et de la barre d'appel, sous le lien d'évitement (et sous le grain, en desktop). */
  .intro {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: none;
    place-items: center;
    padding: var(--gutter);
    /* Noir de la page, et, très bas, un souffle de bleu nuit : l'horizon avant qu'il n'existe. */
    background: radial-gradient(90% 55% at 50% 108%, #0f1626 0%, var(--ink) 72%);
    transition: opacity 0.9s var(--ease-out);
  }

  :global(.has-intro) .intro {
    display: grid;
  }

  .intro.is-leaving {
    opacity: 0;
    pointer-events: none;
  }

  .intro__card {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
    transition: opacity 0.45s var(--ease-out);
  }

  .intro.is-leaving .intro__card {
    opacity: 0;
  }

  .intro__brand,
  .intro__present {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  .intro.is-set .intro__brand,
  .intro.is-set .intro__present {
    opacity: 1;
  }

  .intro__brand {
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: clamp(1.625rem, 3.2vw, 2.75rem);
    line-height: 1;
    letter-spacing: 0.08em;
    margin-right: -0.08em;
  }

  /* Générique : petites capitales très espacées, le bleu de la marque, un temps après le nom. */
  .intro__present {
    font-stretch: var(--semi);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.62em;
    margin-right: -0.62em;
    color: var(--blue-soft);
    transition-delay: 0.45s;
  }

  /* Téléphone : la barre de chargement (2,5 s, linéaire) ; la page ne défile pas pendant l'entrée. */
  .intro__bar {
    display: none;
  }

  @media (max-width: 899px) {
    :global(html.intro-lock) {
      overflow: hidden;
    }

    .intro {
      touch-action: none;
    }

    .intro__bar {
      display: block;
      width: 7.5rem;
      height: 2px;
      margin-top: 0.75rem;
      background: rgb(242 241 238 / 0.14);
      overflow: hidden;
    }

    .intro__bar span {
      display: block;
      width: 100%;
      height: 100%;
      background: #fff;
      transform: scaleX(0);
      transform-origin: 0 50%;
      animation: intro-load 2.5s linear forwards;
    }
  }

  @keyframes intro-load {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro,
    .intro__card,
    .intro__brand,
    .intro__present {
      transition-duration: 0.2s;
      transition-delay: 0s;
    }
  }
</style>
