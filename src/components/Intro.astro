---
/**
 * Entrée : « MECA RIVIERA — PRESENT » sur la nuit. À chaque arrivée — rechargement, réouverture, retour par
 * l'historique, lien vers une section — on atterrit sur le premier plan et l'immersion recommence. Sur tous les
 * formats : 2,5 s pleines, une fine barre blanche qui se remplit, la page immobile pendant ce temps (si la 3D n'est
 * pas prête, l'affiche, identique à sa première image, prend le relais) ; en bas à gauche, les mentions de l'éditeur,
 * comme au générique. La scène attend qu'elle se lève (événement meca:enter). Sans script : aucune entrée.
 */
const year = new Date().getFullYear();
---

<script is:inline>
  (() => {
    // Toujours le premier plan à l'arrivée : aucune position de défilement restaurée, aucune ancre.
    const root = document.documentElement;
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    if (location.hash) history.replaceState(null, '', location.pathname + location.search);
    // Le haut est tenu — à chaque image et à chaque défilement — pendant l'entrée, puis jusqu'à 1,5 s après elle et
    // après le chargement complet, si lent soit-il : Safari et les navigateurs intégrés aux applications rétablissent
    // parfois la position tard. Pendant ce temps (is-held), le retour en haut est instantané (jamais un glissé qu'un
    // doigt interromprait à mi-page) et le défilement n'a aucun point d'accroche (pas guidés) qui le retiendrait plus
    // bas. Le premier geste du visiteur, une fois l'entrée levée, lui rend la main. En partant, la page se remet en
    // haut, sans glissé : un navigateur qui garderait malgré tout une position n'a que celle-là.
    let free = false;
    let entered = false;
    let until = Infinity;
    const top = () => {
      if (!free && (scrollX || scrollY)) scrollTo(0, 0);
    };
    const letGo = () => {
      if (free) return;
      free = true;
      root.classList.remove('is-held');
      removeEventListener('scroll', top);
    };
    const hold = (now) => {
      if (free) return;
      // Garde-fou : la main rendue au plus tard 25 s après l'arrivée, même sans chargement complet.
      if (now > until || now > 25000) return letGo();
      top();
      requestAnimationFrame(hold);
    };
    root.classList.add('is-held');
    scrollTo(0, 0);
    requestAnimationFrame(hold);
    addEventListener('scroll', top, { passive: true });
    const arm = () => {
      if (entered && document.readyState === 'complete') until = performance.now() + 1500;
    };
    addEventListener(
      'meca:enter',
      () => {
        entered = true;
        top();
        arm();
      },
      { once: true },
    );
    addEventListener('load', arm, { once: true });
    const release = () => {
      if (entered && !root.classList.contains('intro-lock')) letGo();
    };
    // Geste, clavier, ou focus déplacé (lecteur d'écran) : la main au visiteur.
    for (const type of ['wheel', 'touchstart', 'keydown', 'pointerdown', 'focusin']) addEventListener(type, release, { capture: true, passive: true });
    // Contrôle QA (captures) : la main tout de suite.
    addEventListener('meca:intro-finish', letGo, { once: true });
    addEventListener('pagehide', () => {
      root.classList.add('is-held');
      scrollTo(0, 0);
    });
    // Page restaurée telle quelle (retour par l'historique) : rechargée, l'entrée avec.
    addEventListener('pageshow', (event) => event.persisted && location.reload());
    root.classList.add('has-intro');
    // La page immobile pendant l'entrée.
    root.classList.add('intro-lock');
  })();
</script>
<div class="intro" data-intro aria-hidden="true" data-nosnippet>
  <p class="intro__card">
    <span class="intro__brand"><span class="meca">MECA</span> RIVIERA</span>
    <span class="intro__present">PRESENT</span>
    <!-- Téléphone : une fine barre blanche se remplit pendant les 2,5 s de l'entrée. -->
    <span class="intro__bar"><span></span></span>
  </p>
  <!-- Téléphone : les mentions, en bas à gauche. -->
  <p class="intro__legal">
    <span>© {year} MECA RIVIERA · Tous droits réservés</span>
    <span>Mentions légales · CGU · CLU</span>
    <span>Conception nexoDeveloppement</span>
  </p>
</div>
<script is:inline>
  (() => {
    const root = document.documentElement;
    const intro = document.querySelector('[data-intro]');
    if (!intro) return;
    if (!root.classList.contains('has-intro')) return intro.remove();
    // L'entrée dure ses 2,5 s (la barre), sans être écourtée par un geste ; au-delà, si la 3D n'est pas prête,
    // l'affiche prend le relais : la page n'attend pas une ressource lente.
    const MIN = 2500;
    const MAX = 2500;
    const start = performance.now();
    let leaving = false;
    const leave = (instant) => {
      if (leaving) return;
      leaving = true;
      clearTimeout(timer);
      root.classList.remove('intro-lock');
      dispatchEvent(new CustomEvent('meca:enter'));
      const done = () => {
        intro.remove();
        root.classList.remove('has-intro');
      };
      if (instant) return done();
      intro.classList.add('is-leaving');
      intro.addEventListener('transitionend', (event) => event.target === intro && done());
      setTimeout(done, 1600);
    };
    const timer = setTimeout(() => leave(false), MAX);
    // Scène prête (événement de la 3D, ou repli statique : l'affiche doit alors être décodée).
    addEventListener(
      'meca:scene-ready',
      (event) => {
        const poster = event.detail?.static ? document.querySelector('.stage__poster img') : null;
        const decoded = poster?.decode
          ? Promise.race([poster.decode().catch(() => {}), new Promise((resolve) => setTimeout(resolve, 1500))])
          : Promise.resolve();
        decoded.then(() => setTimeout(() => leave(false), Math.max(0, MIN - (performance.now() - start))));
      },
      { once: true },
    );
    // Contrôle QA (captures) : levée immédiate, sans transition.
    addEventListener('meca:intro-finish', () => leave(true), { once: true });
    // Le titre n'apparaît qu'avec sa police (préchargée) : jamais de changement de fonte à l'écran.
    Promise.race([document.fonts ? document.fonts.ready : null, new Promise((resolve) => setTimeout(resolve, 800))]).then(() =>
      intro.classList.add('is-set'),
    );
  })();
</script>

<style>
  /* Haut de page tenu à l'arrivée (script en tête) : retour instantané, sans point d'accroche. */
  :global(html.is-held) {
    scroll-behavior: auto !important;
    scroll-snap-type: none !important;
  }

  /* Au-dessus de l'en-tête et de la barre d'appel, sous le lien d'évitement (et sous le grain, en desktop). */
  .intro {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: none;
    place-items: center;
    padding: var(--gutter);
    /* Noir de la page, et, très bas, un souffle de bleu nuit : l'horizon avant qu'il n'existe. */
    background: radial-gradient(90% 55% at 50% 108%, #0f1626 0%, var(--ink) 72%);
    transition: opacity 0.9s var(--ease-out);
  }

  :global(.has-intro) .intro {
    display: grid;
  }

  .intro.is-leaving {
    opacity: 0;
    pointer-events: none;
  }

  .intro__card {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
    transition: opacity 0.45s var(--ease-out);
  }

  .intro.is-leaving .intro__card {
    opacity: 0;
  }

  .intro__brand,
  .intro__present {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  .intro.is-set .intro__brand,
  .intro.is-set .intro__present {
    opacity: 1;
  }

  .intro__brand {
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: clamp(1.625rem, 3.2vw, 2.75rem);
    line-height: 1;
    letter-spacing: 0.08em;
    margin-right: -0.08em;
  }

  /* Générique : petites capitales très espacées, le bleu de la marque, un temps après le nom. */
  .intro__present {
    font-stretch: var(--semi);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.62em;
    margin-right: -0.62em;
    color: var(--blue-soft);
    transition-delay: 0.45s;
  }

  /* La barre de chargement (2,5 s, linéaire) ; la page ne défile pas pendant l'entrée. */
  :global(html.intro-lock) {
    overflow: hidden;
  }

  .intro {
    touch-action: none;
  }

  .intro__bar {
    display: block;
    width: 7.5rem;
    height: 2px;
    margin-top: 0.75rem;
    background: rgb(242 241 238 / 0.14);
    overflow: hidden;
  }

  .intro__bar span {
    display: block;
    width: 100%;
    height: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: 0 50%;
    animation: intro-load 2.5s linear forwards;
  }

  /* Les mentions : petites capitales discrètes, en bas à gauche, qui arrivent avec le titre. */
  .intro__legal {
    position: absolute;
    inset: auto auto calc(1.25rem + env(safe-area-inset-bottom)) var(--gutter);
    /* Hors du centrage de l'entrée (grille centrée) : calé en bas à gauche. */
    place-self: end start;
    display: grid;
    gap: 0.3rem;
    font-stretch: var(--semi);
    font-weight: 500;
    font-size: 0.625rem;
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    opacity: 0;
    transition: opacity 1.2s var(--ease-out) 0.6s;
  }

  .intro.is-set .intro__legal {
    opacity: 1;
  }

  @keyframes intro-load {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro,
    .intro__card,
    .intro__brand,
    .intro__present {
      transition-duration: 0.2s;
      transition-delay: 0s;
    }
  }
</style>
