---
import { inspection } from '../content/site';

const parts = inspection.value;
const pad = (n: number) => String(n).padStart(2, '0');
// Longueur de scroll de chaque étape (écrans × 100) : le compartiment se lit, les pièces s'enchaînent.
const SPAN: Record<string, number> = { capot: 100, huile: 80, refroidissement: 80, frein: 80, moteur: 100 };
---

<section class="method" id="methode" aria-labelledby="methode-title" data-inspection>
  <div class="method__viewport" aria-hidden="true">
    <!-- Repli sans 3D (sans script, sans WebGL, contexte perdu) : le compartiment moteur relevé, capturé
         sur la scène (npm run assets:posters -- inspection). Avec la 3D, l'inspection s'ouvre sur le noir. -->
    <picture class="method__poster">
      <source media="(max-width: 899px)" type="image/avif" srcset="/media/inspection-mobile.avif" width="780" height="1688" />
      <source media="(max-width: 899px)" type="image/webp" srcset="/media/inspection-mobile.webp" width="780" height="1688" />
      <source type="image/avif" srcset="/media/inspection-desktop.avif" />
      <img src="/media/inspection-desktop.webp" width="1440" height="900" loading="lazy" decoding="async" alt="" />
    </picture>
    <canvas class="method__canvas" data-inspection-canvas></canvas>
    <svg class="method__callout" data-callout>
      <path class="method__callout-line" d=""></path>
      <circle class="method__callout-ring" r="8"></circle>
      <circle class="method__callout-dot" r="2.5"></circle>
    </svg>
  </div>

  <div class="method__content">
    <div class="insp insp--intro" data-stop="releve">
      <div class="insp__panel" data-focus data-caption>
        <p class="label method__kicker">Méthode</p>
        <h2 class="method__title" id="methode-title">
          <span>Votre véhicule</span>{' '}
          <span>ne bouge pas.</span>{' '}
          <span class="method__accent">Nous, si.</span>
        </h2>
        <p class="method__lede">
          Pas de remorquage jusqu’au garage, pas de journée perdue à attendre&nbsp;: l’outillage et les pièces viennent à la voiture,
          chez vous.
        </p>
        <p class="method__hint label">Inspection d’un véhicule réel, relevé en 3D ↓</p>
      </div>
    </div>

    {
      parts.map((part, i) => (
        <article class="insp" data-stop={part.key} aria-labelledby={`insp-${part.key}`} style={`--span: ${SPAN[part.key] ?? 100}`}>
          <div class="insp__panel" data-focus data-caption>
            <p class="insp__index label" data-callout-origin>
              <span class="insp__num">{pad(i + 1)}</span>
              <span class="insp__total">/ {pad(parts.length)}</span>
              <span class="insp__zone">{part.zone}</span>
            </p>
            <h3 class="insp__title" id={`insp-${part.key}`}>
              {part.title}
            </h3>
            <p class="insp__text">{part.text}</p>
            {part.service && <p class="insp__service label">Service lié · {part.service}</p>}
          </div>
        </article>
      ))
    }

    <!-- Prendre de la hauteur : la voiture devient un point, la carte demande où. -->
    <div class="insp insp--depart" data-stop="depart" style="--span: 100">
      <div class="insp__panel" data-focus data-caption>
        <p class="insp__closing">On sait quoi regarder. Reste à savoir où.</p>
      </div>
    </div>
    <!-- Un temps d'arrêt après le dernier cadrage : la vue reste épinglée sur la voiture devenue point, la
         dernière phrase se lit, puis la carte monte. -->
    <div class="insp__tail" aria-hidden="true"></div>
  </div>
</section>

<script>
  import { INSPECTION_PACES } from '../3d/inspection-paces';
  import { mountCaptions } from '../motion/captions';
  import { createStageProgress } from '../motion/stage-progress';

  // L'inspection 3D ne se charge qu'à l'approche de la section par le haut (un écran avant), ou quand elle
  // revient à l'écran : pas pour une section laissée derrière soi (lien direct vers la carte ou la
  // demande) — sa compilation priverait la carte de ses images.
  const root = document.querySelector<HTMLElement>('[data-inspection]');
  const canvas = root?.querySelector<HTMLCanvasElement>('[data-inspection-canvas]');
  const stops = root ? [...root.querySelectorAll<HTMLElement>('[data-stop]')] : [];
  const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
  const webgl = Boolean(canvas) && !connection?.saveData && 'WebGL2RenderingContext' in window;

  if (root && stops.length) {
    const narrow = matchMedia('(max-width: 899px)');
    // Légendes mobiles : mise en page posée dès le chargement (aucun saut à l'arrivée), pilotage à l'approche.
    root.classList.toggle('has-captions', narrow.matches);
    // La 3D prendra le relais : pas d'affiche (l'inspection s'ouvre sur le noir, la ligne de scan révèle).
    if (webgl) root.classList.add('has-3d');
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        observer.disconnect();
        // Arrêts mesurés à l'approche seulement : aucune mise en page forcée au chargement de la page.
        const progress = createStageProgress(stops, narrow);
        // Le titre reste pendant la première moitié du balayage, puis chaque pièce a sa légende.
        const paces = stops.map((el) => INSPECTION_PACES[el.dataset.stop ?? '']);
        mountCaptions(root, stops, progress, narrow, paces, { firstUntil: 0.35 });
        if (!webgl || !canvas) return;
        import('../3d/inspection')
          .then(({ createInspection }) => createInspection({ root, canvas, stops, progress, narrow }))
          .catch((error) => {
            console.warn('[inspection] 3D indisponible, relevé fixe conservé.', error);
            root.classList.remove('has-3d');
            root.classList.add('is-static');
          });
      },
      { rootMargin: '0px 0px 100% 0px' },
    );
    observer.observe(root);
  }
</script>

<style>
  /* Sans bordure : la section s'ouvre sur le même noir que la fin du tour — une seule nuit. */
  .method {
    position: relative;
    background: var(--ink);
  }

  .method__viewport {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
  }

  .method__poster img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .method:global(.has-3d) .method__poster {
    display: none;
  }

  .method__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }

  .method__canvas:global(.is-ready) {
    opacity: 1;
  }

  .method__callout {
    position: absolute;
    z-index: 1;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    opacity: 0;
  }

  /* Desktop : voile sous la colonne de texte, quand le véhicule s'en approche. */
  @media (min-width: 900px) {
    .method__viewport::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, var(--ink) 0%, rgb(11 12 14 / 0.72) 26%, rgb(11 12 14 / 0) 44%);
      pointer-events: none;
    }
  }

  .method__callout-line,
  .method__callout-ring {
    fill: none;
    stroke: var(--blue-soft);
    stroke-width: 1;
  }

  .method__callout-dot {
    fill: var(--paper);
  }

  .method__content {
    position: relative;
    margin-top: -100vh;
    margin-top: -100svh;
  }

  .insp {
    display: flex;
    align-items: center;
    min-height: calc(var(--span, 100) * 1vh);
    min-height: calc(var(--span, 100) * 1svh);
    max-width: var(--max);
    margin-inline: auto;
    padding: 6rem var(--gutter);
  }

  /* Introduction plus haute : le balayage de la ligne de scan dispose d'un plus long trajet de scroll. */
  .insp--intro {
    min-height: 130vh;
    min-height: 130svh;
  }

  .insp__panel {
    width: clamp(20rem, 29vw, 26rem);
  }

  .insp--intro .insp__panel {
    width: clamp(22rem, 38vw, 36rem);
  }

  .method__kicker {
    color: var(--blue-soft);
  }

  .method__title {
    margin-top: 1.25rem;
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: clamp(2rem, 4.4vw, 4.5rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .method__title span {
    display: block;
  }

  .method__accent {
    color: var(--blue-soft);
  }

  .method__lede {
    max-width: 30rem;
    margin-top: 1.75rem;
    font-size: clamp(1rem, 1.15vw, 1.1875rem);
    color: var(--text-2);
  }

  .method__hint {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--text-3);
  }

  .insp__index {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--text-3);
  }

  .insp__num {
    color: var(--text);
  }

  .insp__zone {
    margin-left: auto;
    color: var(--blue-soft);
  }

  .insp__title {
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: clamp(1.625rem, 2.4vw, 2.25rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .insp__text {
    margin-top: 1rem;
    font-size: 1.0625rem;
  }

  .insp__service {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    color: var(--text-3);
  }

  .insp__service::before {
    content: '';
    width: 0.25rem;
    height: 0.25rem;
    background: var(--blue-soft);
  }

  /* — Prendre de la hauteur ——————————————————— */

  .insp__tail {
    height: 60vh;
    height: 60svh;
  }

  .insp__closing {
    font-stretch: var(--wide);
    font-weight: 800;
    font-size: clamp(1.5rem, 2.6vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  /* — Mobile : le véhicule en haut, le texte en feuilles qui montent par-dessus ——— */

  @media (max-width: 899px) {
    .insp {
      display: block;
      min-height: 0;
      max-width: none;
      padding: calc(var(--span, 100) * 0.6vh) 0 0;
      padding: calc(var(--span, 100) * 0.6svh) 0 0;
    }

    .insp__panel,
    .insp--intro .insp__panel {
      width: 100%;
      padding: 1.75rem var(--gutter) 2.75rem;
      background: var(--ink);
      border-top: 1px solid var(--line);
    }

    /* Dernière feuille : jusqu'au bas de l'écran, sinon la section s'achève avant et la vue
       épinglée remonte avec elle au dernier arrêt. */
    .insp:last-child .insp__panel {
      min-height: 50vh;
      min-height: 50svh;
    }

    /* — Avec légendes (script) : comme la scène d'ouverture — les arrêts deviennent des longueurs de scroll,
       le texte une légende en bas de l'écran, visible quand la caméra est arrivée, jamais sur le relevé. */
    .method:global(.has-captions) .insp {
      min-height: calc(var(--span, 100) * 1vh);
      min-height: calc(var(--span, 100) * 1svh);
      padding: 0;
    }

    .method:global(.has-captions) .insp--intro {
      min-height: 130vh;
      min-height: 130svh;
    }

    /* La dernière feuille (repli) avait une hauteur minimale : l'annuler sans rien d'autre (un sélecteur plus
       précis ici l'emporterait sur l'état actif de la légende). */
    .method:global(.has-captions) .insp:last-child [data-caption] {
      min-height: 0;
    }

    .method:global(.has-captions) [data-caption] {
      position: fixed;
      inset: auto 0 calc(4.5rem + 1px + env(safe-area-inset-bottom));
      z-index: 2;
      padding: 3rem var(--gutter) 1.25rem;
      background: linear-gradient(0deg, var(--ink) 62%, rgb(11 12 14 / 0));
      border-top: 0;
      opacity: 0;
      transform: translateY(0.75rem);
      pointer-events: none;
    }

    .method:global(.has-captions) [data-caption]:global(.is-active),
    .method:global(.has-captions) [data-caption]:focus-within {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }

    /* Fondus, une fois la mise en page posée (captions-ready, à l'approche) : au chargement, aucune légende
       ne s'efface à l'écran ; ensuite, sortie brève et entrée différée — jamais deux légendes à la fois. */
    .method:global(.has-captions.captions-ready) [data-caption] {
      transition:
        opacity 0.2s var(--ease-out),
        transform 0.2s var(--ease-out);
    }

    .method:global(.has-captions.captions-ready) [data-caption]:global(.is-active),
    .method:global(.has-captions.captions-ready) [data-caption]:focus-within {
      transition:
        opacity 0.35s var(--ease-out) 0.12s,
        transform 0.35s var(--ease-out) 0.12s;
    }

    .method:global(.has-captions) .insp__index {
      margin-bottom: 1rem;
      padding-bottom: 0.875rem;
    }
  }

  @media (max-width: 899px) and (prefers-reduced-motion: reduce) {
    .method:global(.has-captions) [data-caption] {
      transform: none;
    }

    .method:global(.has-captions.captions-ready) [data-caption],
    .method:global(.has-captions.captions-ready) [data-caption]:global(.is-active) {
      transition-duration: 0.15s;
      transition-delay: 0s;
    }
  }

  @media (max-width: 699px) {
    .method__title {
      font-size: 8.2vw;
    }
  }
</style>
