---
import { contact } from '../content/site';

const phones = contact.phones.value;
---

<!-- Sans script, la barre n'apparaît jamais (inert, hors écran) : les numéros restent dans le hero et le contact. -->
<nav class="mbar" data-mbar aria-label="Contact rapide" inert>
  <!-- Appeler : la mention seule ; au toucher, le choix entre les deux numéros, dans une feuille au-dessus de la barre. -->
  <button class="mbar__call" type="button" aria-expanded="false" aria-controls="mbar-pick" data-call>
    <span>Appeler</span>
    <svg class="mbar__caret" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 6.5 5 3l3.5 3.5"></path></svg>
  </button>
  <a class="mbar__req" href="#demande">Demande</a>
  <div class="mbar__pick" id="mbar-pick" data-pick hidden>
    <p class="mbar__pick-title label">Appeler MECA RIVIERA</p>
    <ul class="mbar__lines">
      {
        phones.map((p) => (
          <li>
            <a class="mbar__line" href={p.href} aria-label={`Appeler le ${p.display}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" />
              </svg>
              <span>{p.display}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  // Barre d'action mobile : apparaît une fois le hero dépassé (ses propres boutons suffisent au-dessus). « Appeler »
  // ouvre le choix entre les deux numéros ; la feuille se ferme au choix, en touchant ailleurs, à Échap, quand la page
  // défile ou que la barre s'efface.
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  const call = bar?.querySelector<HTMLButtonElement>('[data-call]');
  const pick = bar?.querySelector<HTMLElement>('[data-pick]');
  if (bar && call && pick) {
    let openedAt = 0;
    const setOpen = (open: boolean) => {
      if (open === !pick.hidden) return;
      pick.hidden = !open;
      call.setAttribute('aria-expanded', String(open));
      bar.classList.toggle('is-open', open);
      openedAt = window.scrollY;
    };
    const update = () => {
      const visible = window.scrollY > window.innerHeight * 0.6;
      bar.classList.toggle('is-visible', visible);
      // Seulement quand l'état change : aucune écriture dans la page à chaque défilement.
      if (bar.inert === visible) bar.inert = !visible;
      if (!visible || Math.abs(window.scrollY - openedAt) > 40) setOpen(false);
    };
    update();
    addEventListener('scroll', update, { passive: true });
    call.addEventListener('click', () => setOpen(pick.hidden));
    for (const line of pick.querySelectorAll('a')) line.addEventListener('click', () => setTimeout(() => setOpen(false), 400));
    document.addEventListener('click', (event) => {
      if (!pick.hidden && !bar.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || pick.hidden) return;
      setOpen(false);
      call.focus();
    });
  }
</script>

<style>
  .mbar {
    position: fixed;
    inset: auto 0 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
    padding: 0.625rem var(--gutter) calc(0.625rem + env(safe-area-inset-bottom));
    background: rgb(11 12 14 / 0.96);
    border-top: 1px solid var(--line);
    transform: translateY(100%);
    transition: transform 0.4s var(--ease-out);
  }

  .mbar.is-visible {
    transform: none;
  }

  .mbar a,
  .mbar__call {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    font-weight: 600;
  }

  .mbar__call {
    gap: 0.625rem;
    padding: 0 0.875rem;
    border: 0;
    background: var(--blue);
    color: #fff;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .mbar__call:active {
    background: #1a46e8;
  }

  .mbar__caret {
    flex: none;
    width: 0.625rem;
    height: 0.625rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.25s var(--ease-out);
  }

  .mbar.is-open .mbar__caret {
    transform: rotate(180deg);
  }

  .mbar__req {
    padding: 0 1.25rem;
    border: 1px solid var(--line-strong);
  }

  /* Le choix du numéro : une feuille posée sur la barre, deux grands boutons d'appel. */
  .mbar__pick {
    position: absolute;
    inset: auto 0 100%;
    display: grid;
    gap: 0.875rem;
    padding: 1.25rem var(--gutter) 1rem;
    background: var(--ink);
    border-top: 1px solid var(--line);
    animation: mbar-pick 0.28s var(--ease-out);
  }

  .mbar__pick[hidden] {
    display: none;
  }

  .mbar__pick-title {
    color: var(--text-3);
  }

  .mbar__lines {
    display: grid;
    gap: 0.5rem;
  }

  .mbar .mbar__line {
    justify-content: flex-start;
    gap: 0.875rem;
    min-height: 3.5rem;
    padding: 0 1.25rem;
    background: var(--blue);
    color: #fff;
    font-weight: 700;
    font-size: 1.1875rem;
    letter-spacing: 0.02em;
  }

  .mbar .mbar__line:active {
    background: #1a46e8;
  }

  .mbar__line svg {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    fill: currentColor;
  }

  @keyframes mbar-pick {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  @media (min-width: 900px) {
    .mbar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mbar,
    .mbar__caret {
      transition: none;
    }

    .mbar__pick {
      animation: none;
    }
  }
</style>
